# Public site URL. Canonical, Open Graph, sitemap, and robots use this value,
# and fall back to https://drovyr.com when it is unset.
# The lead API will not send a request unless this variable is set.
NEXT_PUBLIC_SITE_URL=https://drovyr.com

# All three are required before /api/lead will deliver a request.
# There is no fallback API key, recipient, or from-address.
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=
RESEND_FROM_EMAIL=

# Optional. Leave unset to skip Google Analytics. Do not put a placeholder ID here.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
